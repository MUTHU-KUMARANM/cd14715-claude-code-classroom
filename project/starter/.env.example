# Environment variables for local development.
# Keep live credentials in your shell or an untracked .env file.

# Required: Anthropic API key, or configure AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, and AWS_REGION for Bedrock.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Required for GitHub MCP pull-request access.
# Generate a least-privilege token with repository read access.
GITHUB_TOKEN=ghp_your-token-here

# Optional
LOG_LEVEL=info
